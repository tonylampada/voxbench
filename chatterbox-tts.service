[Unit]
Description=Chatterbox TTS Server
After=network.target

[Service]
Type=simple
User=ai
WorkingDirectory=/home/ai/clawd/repos/chatterbox_server
Environment="PATH=/home/ai/clawd/repos/chatterbox_server/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/ai/clawd/repos/chatterbox_server/.venv/bin/python server.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
